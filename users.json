import getpass, hashlib, json, os, time
 
username = input("Username: ").strip().lower()
password = getpass.getpass("Password (hidden): ")
days = int(input("Days of access (0 = lifetime): ") or 0)
hwid = input("User's HWID (64 characters): ").strip().lower()
 
if len(hwid) != 64 or any(c not in "0123456789abcdef" for c in hwid):
    raise SystemExit("Invalid HWID: must be 64 hex characters.")
 
salt = os.urandom(16)
entry = {username: {
    "salt": salt.hex(),
    "hash": hashlib.pbkdf2_hmac("sha256", password.encode(), salt, 200000).hex(),
    "hwid": hwid,
    "expires": int(time.time() + days * 86400) if days > 0 else 0,
}}
 
text = json.dumps(entry, indent=2)
print("\n--- paste this inside users.json (add a comma between entries) ---\n")
print(text[2:-2])
